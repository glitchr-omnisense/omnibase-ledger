{% extends '@Admin/layout.html.twig' %}

{% block page_title %}{{ 'report.general_ledger'|trans({}, 'ledger') }} · {{ book.name }}{% endblock %}

{% block content_header %}
<div class="admin-header">
    <span class="admin-header-icon"><i class="fa-solid fa-book-open"></i></span>
    <div class="admin-header-titles">
        <h1>{{ 'report.general_ledger'|trans({}, 'ledger') }} · {{ book.name }}</h1>
        <div class="admin-header-subtitle">{{ 'report.period'|trans({from: from|date('d/m/Y'), to: to|date('d/m/Y')}, 'ledger') }}{% if prefix %} · {{ prefix }}…{% endif %}</div>
    </div>
</div>
{% endblock %}

{% block content %}
{{ include('@Ledger/admin/_style.html.twig') }}
<div class="ledger">
    {{ include('@Ledger/admin/_report_nav.html.twig', {current: 'ledger_admin_general_ledger'}) }}
    {{ include('@Ledger/admin/_period.html.twig', {extra: '<label>' ~ ('report.account'|trans({}, 'ledger')) ~ '<input class="form-control" name="account" value="' ~ (prefix|e('html_attr')) ~ '" placeholder="411"></label>'}) }}
    {{ include('@Ledger/admin/_dimension_filter.html.twig', {current: 'ledger_admin_general_ledger', link: {book: book.id, from: from|date('Y-m-d'), to: to|date('Y-m-d'), account: prefix, by: by|default(null)}}) }}
    {% for group in groups ?? [{value: null, label: null, accounts: accounts}] %}
    {% if by|default(null) %}<h2 class="h5">{{ include('@Ledger/admin/_axis.html.twig', {axis: by}) }} : {{ group.label ?? ('report.unassigned'|trans({}, 'ledger')) }}</h2>{% endif %}
    {% for account in group.accounts %}
    <div class="card">
        <strong>{{ account.number }} {{ account.label }}</strong>
        <table>
            <thead><tr><th>{{ 'report.date'|trans({}, 'ledger') }}</th><th>Jnl</th><th>N°</th><th>{{ 'report.piece'|trans({}, 'ledger') }}</th><th>{{ 'report.label'|trans({}, 'ledger') }}</th><th class="num">{{ 'report.debit'|trans({}, 'ledger') }}</th><th class="num">{{ 'report.credit'|trans({}, 'ledger') }}</th><th class="num">{{ 'report.balance'|trans({}, 'ledger') }}</th><th>Let.</th></tr></thead>
            <tbody>
            {% for line in account.lines %}
                <tr>
                    <td>{{ line.date|date('d/m/Y') }}</td><td>{{ line.journal }}</td><td class="muted">{{ line.number }}</td><td>{{ line.piece }}</td>
                    <td>{{ line.label }}{% if line.party %} <span class="muted">· {{ line.party }}</span>{% endif %}</td>
                    <td class="num">{{ line.debit|ledger_amount }}</td><td class="num">{{ line.credit|ledger_amount }}</td><td class="num">{{ line.balance|ledger_amount ?: '0,00' }}</td><td>{{ line.letter }}</td>
                </tr>
            {% endfor %}
            </tbody>
            <tfoot><tr><th colspan="5">{{ 'report.total'|trans({}, 'ledger') }}</th><th class="num">{{ account.debit|ledger_amount }}</th><th class="num">{{ account.credit|ledger_amount }}</th><th class="num">{{ account.balance|ledger_amount ?: '0,00' }}</th><th></th></tr></tfoot>
        </table>
    </div>
    {% else %}
    <div class="card muted">{{ 'report.empty'|trans({}, 'ledger') }}</div>
    {% endfor %}
    {% endfor %}
</div>
{% endblock %}
