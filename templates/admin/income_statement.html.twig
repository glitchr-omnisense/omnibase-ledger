{% extends '@Admin/layout.html.twig' %}

{% block page_title %}{{ 'report.income_statement'|trans({}, 'ledger') }} · {{ book.name }}{% endblock %}

{% block content_header %}
<div class="admin-header">
    <span class="admin-header-icon"><i class="fa-solid fa-chart-line"></i></span>
    <div class="admin-header-titles">
        <h1>{{ 'report.income_statement'|trans({}, 'ledger') }} · {{ book.name }}</h1>
        <div class="admin-header-subtitle">
            {{ 'report.period'|trans({from: from|date('d/m/Y'), to: to|date('d/m/Y')}, 'ledger') }}
            {% if compare %} · {{ 'report.previous_period'|trans({from: previous_from|date('d/m/Y'), to: previous_to|date('d/m/Y')}, 'ledger') }}{% endif %}
        </div>
    </div>
</div>
{% endblock %}

{% block content %}
{{ include('@Ledger/admin/_style.html.twig') }}
{% set link = {book: book.id, from: from|date('Y-m-d'), to: to|date('Y-m-d')}|merge(filter|default({}) is not empty ? {dimension: filter} : {}) %}
<div class="ledger">
    {{ include('@Ledger/admin/_report_nav.html.twig', {current: 'ledger_admin_income_statement'}) }}
    {{ include('@Ledger/admin/_period.html.twig') }}
    {{ include('@Ledger/admin/_dimension_filter.html.twig', {current: 'ledger_admin_income_statement', link: link|merge({n1: compare ? 1 : 0})}) }}
    <div class="toolbar no-print">
        <button type="button" class="btn btn-sm btn-secondary" onclick="window.print()"><i class="fa-solid fa-print"></i> {{ 'report.print'|trans({}, 'ledger') }}</button>
        <a class="btn btn-sm btn-secondary" href="{{ path('ledger_admin_income_statement', link|merge({n1: compare ? 1 : 0, format: 'csv'})) }}"><i class="fa-solid fa-file-csv"></i> CSV</a>
    </div>
    <div class="statements">
        <div class="card">
            {{ include('@Ledger/admin/_statement.html.twig', {title: 'report.income'|trans({}, 'ledger'), groups: report.income, total_label: 'report.total_income'|trans({}, 'ledger'), total: report.totals.income, previous_total: report.previous.income ?? null, link: link}) }}
        </div>
        <div class="card">
            {{ include('@Ledger/admin/_statement.html.twig', {title: 'report.expenses'|trans({}, 'ledger'), groups: report.expenses, total_label: 'report.total_expenses'|trans({}, 'ledger'), total: report.totals.expenses, previous_total: report.previous.expenses ?? null, link: link}) }}
        </div>
    </div>
    <div class="card">
        <table class="statement">
            <tfoot><tr>
                <th colspan="2">{{ 'report.net_result'|trans({}, 'ledger') }} <span class="pill">{{ (report.totals.result >= 0 ? 'report.profit' : 'report.loss')|trans({}, 'ledger') }}</span></th>
                <th class="num {{ report.totals.result >= 0 ? 'in' : 'out' }}">{{ report.totals.result|ledger_money(book.currency) }}</th>
                {% if compare %}<th class="num {{ report.previous.result >= 0 ? 'in' : 'out' }}">{{ report.previous.result|ledger_money(book.currency) }}</th>{% endif %}
            </tr></tfoot>
        </table>
    </div>
</div>
{% endblock %}
