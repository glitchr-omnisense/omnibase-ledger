{% extends '@Admin/layout.html.twig' %}

{% block page_title %}{{ 'report.vat_return'|trans({}, 'ledger') }} · {{ book.name }}{% endblock %}

{% block content_header %}
<div class="admin-header">
    <span class="admin-header-icon"><i class="fa-solid fa-percent"></i></span>
    <div class="admin-header-titles">
        <h1>{{ 'report.vat_return'|trans({}, 'ledger') }} · {{ book.name }}</h1>
        <div class="admin-header-subtitle">{{ 'report.period'|trans({from: from|date('d/m/Y'), to: to|date('d/m/Y')}, 'ledger') }} · {{ report.regime.label }}</div>
    </div>
</div>
{% endblock %}

{% block content %}
{# The CA3's boxes (or the CA12's totals, simplified regime) over the
   period, from the book's taxed lines; a book outside VAT says so. #}
{{ include('@Ledger/admin/_style.html.twig') }}
{% set link = {book: book.id, from: from|date('Y-m-d'), to: to|date('Y-m-d')} %}
<div class="ledger">
    {{ include('@Ledger/admin/_report_nav.html.twig', {current: 'ledger_admin_vat_return'}) }}
    {{ include('@Ledger/admin/_period.html.twig') }}
    {% if not report.liable %}
    <div class="card">
        <strong>{{ ('vat.not_liable.' ~ report.regime.value)|trans({}, 'ledger') }}</strong>
        <div class="muted">{{ 'vat.not_liable_hint'|trans({}, 'ledger') }}</div>
    </div>
    {% endif %}
    <div class="toolbar no-print">
        <button type="button" class="btn btn-sm btn-secondary" onclick="window.print()"><i class="fa-solid fa-print"></i> {{ 'report.print'|trans({}, 'ledger') }}</button>
        <a class="btn btn-sm btn-secondary" href="{{ path('ledger_admin_vat_return', link|merge({format: 'csv'})) }}"><i class="fa-solid fa-file-csv"></i> CSV</a>
    </div>
    {% if report.form == 'CA12' %}
    <div class="card">
        <table class="statement">
            <thead><tr><th colspan="2">{{ 'vat.ca12'|trans({}, 'ledger') }}</th><th class="num">{{ 'vat.vat'|trans({}, 'ledger') }}</th></tr></thead>
            <tbody>
            {% for key in ['collected', 'deductible_fixed_assets', 'deductible_goods_services', 'deductible_total', 'credit', 'net_due'] %}
                <tr><td colspan="2">{{ ('vat.ca12_' ~ key)|trans({}, 'ledger') }}</td><td class="num">{{ report.ca12[key]|ledger_amount ?: '0,00' }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
    <div class="card">
        <table class="statement">
            <thead><tr>
                <th>{{ 'vat.box'|trans({}, 'ledger') }}</th>
                <th>{{ 'report.label'|trans({}, 'ledger') }}</th>
                <th class="num">{{ 'vat.base'|trans({}, 'ledger') }}</th>
                <th class="num">{{ 'vat.vat'|trans({}, 'ledger') }}</th>
            </tr></thead>
            <tbody>
            {% for box in report.boxes %}
                <tr>
                    <td>{{ box.box }}</td>
                    <td>{{ box.label }}</td>
                    <td class="num">{{ box.base is null ? '' : (box.base|ledger_amount ?: '0,00') }}</td>
                    <td class="num">{{ box.amount is null ? '' : (box.amount|ledger_amount ?: '0,00') }}</td>
                </tr>
            {% endfor %}
            </tbody>
            <tfoot><tr>
                <th colspan="3">{{ (report.credit > 0 ? 'vat.credit' : 'vat.net_due')|trans({}, 'ledger') }}</th>
                <th class="num">{{ (report.credit > 0 ? report.credit : report.net_due)|ledger_money(book.currency) }}</th>
            </tr></tfoot>
        </table>
    </div>
    {% if report.taxes is not empty %}
    <div class="card">
        <table>
            <thead><tr><th>{{ 'vat.code'|trans({}, 'ledger') }}</th><th>{{ 'report.label'|trans({}, 'ledger') }}</th><th class="num">{{ 'vat.base'|trans({}, 'ledger') }}</th><th class="num">{{ 'vat.vat'|trans({}, 'ledger') }}</th></tr></thead>
            <tbody>
            {% for tax in report.taxes %}
                <tr><td>{{ tax.code }}</td><td>{{ tax.label }}</td><td class="num">{{ tax.base|ledger_amount ?: '0,00' }}</td><td class="num">{{ tax.vat|ledger_amount ?: '0,00' }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% endif %}
</div>
{% endblock %}
