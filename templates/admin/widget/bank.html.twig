{# Base\Ledger\Admin\Widget\BankWidgetType: the bank accounts, their balance
   and what waits to be reconciled, then the latest lines. #}
{% if allowed %}
<div class="analytics-card card ledger-bank">
    <div class="analytics-card-header">
        <h2 class="analytics-card-title">{{ widget.label|trans({}, 'admin') }}</h2>
    </div>
    {# Who manages the books can connect a bank or import a statement, before the first account as after it. #}
    {% set actions %}
        {% if can_manage %}
        <div class="ledger-bank-actions">
            {% for name, label in gateways %}
                <a class="btn {{ accounts is empty ? 'btn-primary' : 'btn-secondary' }}" href="{{ path('ledger_admin_bank_connect', {gateway: name, book: book.id, _token: csrf_token('ledger_bank_connect')}) }}"><i class="fa-solid fa-building-columns"></i> Connecter une banque ({{ label }})</a>
            {% endfor %}
            {% if files %}
                <a class="btn btn-secondary" href="{{ path('ledger_admin_bank_connect', {gateway: 'files', book: book.id}) }}"><i class="fa-solid fa-file-arrow-up"></i> Importer un relevé</a>
            {% endif %}
            {% if gateways is empty and not files %}<span class="ledger-muted">Configurez une passerelle Omnibank (omnibank.gateways) pour relier une banque.</span>{% endif %}
        </div>
        {% endif %}
    {% endset %}
    {% if accounts is empty %}
    <div class="ledger-bank-empty">
        <p>Aucun compte bancaire pour l'instant. Connectez la banque pour que ses opérations arrivent seules, ou importez un relevé.</p>
        {{ actions }}
    </div>
    {% else %}
    <div class="ledger-bank-accounts">
        {% for row in accounts %}
        {% set account = row.account %}
        <div class="ledger-bank-account">
            <div class="ledger-bank-name">
                <strong>{{ account.name }}</strong>
                <span class="ledger-muted">{{ account.iban|ledger_iban }}{% if account.lastSyncedAt %} · synchro {{ account.lastSyncedAt|date('d/m H:i') }}{% endif %}</span>
            </div>
            <div class="ledger-bank-balance">
                <strong>{{ row.balance|ledger_money(account.currency) }}</strong>
                {% if row.bankBalance is not null %}<span class="ledger-muted" title="{{ row.bankBalanceAt ? row.bankBalanceAt|date('d/m/Y H:i') }}">banque {{ row.bankBalance|ledger_money(account.currency) }}</span>{% endif %}
            </div>
            <div class="ledger-bank-status">
                {% if row.needsRenewal %}
                    <a class="ledger-pill is-alert" href="{{ path('ledger_admin_bank_renew', {connection: row.connection.id, _token: csrf_token('ledger_bank_renew_' ~ row.connection.id)}) }}">Renouveler</a>
                {% elseif row.connection.consentStatus.value == 'active' %}
                    <span class="ledger-pill is-ok">Connectée</span>
                {% elseif row.connection.gateway == 'files' %}
                    <a class="ledger-pill" href="{{ path('ledger_admin_bank_upload', {bankAccount: account.id}) }}">Relevés</a>
                {% endif %}
                <a class="ledger-pill{{ row.pending > 0 ? ' is-waiting' }}" href="{{ path('ledger_admin_reconcile', {bankAccount: account.id}) }}">{{ row.pending }} à rapprocher</a>
            </div>
        </div>
        {% endfor %}
    </div>
    {% if latest is not empty %}
    <table class="ledger-bank-latest">
        {% for line in latest %}
        <tr>
            <td class="ledger-muted">{{ line.bookedOn|date('d/m') }}</td>
            <td><span class="ledger-label">{{ line.label }}</span>{% if line.counterpartyName %}<span class="ledger-muted"> · {{ line.counterpartyName }}</span>{% endif %}</td>
            <td class="ledger-num {{ line.amount > 0 ? 'is-in' : 'is-out' }}">{{ line.amount > 0 ? '+' }}{{ line.amount|ledger_money(line.currency) }}</td>
            <td><span class="ledger-pill is-{{ line.status.value }}">{{ ('status.' ~ line.status.value)|trans({}, 'ledger') }}</span></td>
        </tr>
        {% endfor %}
    </table>
    {% endif %}
    {% if can_manage %}<div class="ledger-bank-more">{{ actions }}</div>{% endif %}
    {% endif %}
</div>
<style>
    .ledger-bank-empty, .ledger-bank-accounts, .ledger-bank-more { padding: 0 1rem 1rem; }
    .ledger-bank-empty p { margin: 0 0 .75rem; opacity: .8; }
    .ledger-bank-actions { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
    .ledger-bank-accounts { display: grid; gap: .5rem; }
    .ledger-bank-account { display: grid; grid-template-columns: minmax(0, 1.4fr) auto auto; gap: .75rem; align-items: center; padding: .7rem .9rem; border-radius: .75rem; background: rgba(127, 127, 127, .08); }
    .ledger-bank-name, .ledger-bank-balance { display: grid; gap: .1rem; min-width: 0; }
    .ledger-bank-name strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ledger-bank-balance { text-align: right; }
    .ledger-bank-balance strong { font-size: 1.15rem; font-variant-numeric: tabular-nums; }
    .ledger-bank-status { display: flex; flex-wrap: wrap; gap: .35rem; justify-content: flex-end; }
    .ledger-muted { font-size: .8rem; opacity: .7; }
    .ledger-pill { display: inline-block; padding: .15rem .55rem; border-radius: 999px; font-size: .75rem; background: rgba(127, 127, 127, .14); color: inherit; text-decoration: none; white-space: nowrap; }
    .ledger-pill.is-ok, .ledger-pill.is-reconciled { background: rgba(31, 138, 76, .15); color: #1f8a4c; }
    .ledger-pill.is-alert, .ledger-pill.is-unmatched { background: rgba(252, 104, 117, .18); color: #c63543; }
    .ledger-pill.is-waiting, .ledger-pill.is-suggested { background: rgba(255, 179, 0, .2); color: #8a5a00; }
    .ledger-bank { min-width: 0; }
    .ledger-bank-latest { width: calc(100% - 2rem); margin: 0 1rem 1rem; border-collapse: collapse; font-size: .85rem; table-layout: fixed; }
    .ledger-bank-latest td:first-child { width: 3rem; } .ledger-bank-latest td:nth-child(3) { width: 7.5rem; } .ledger-bank-latest td:nth-child(4) { width: 6.5rem; }
    .ledger-bank-latest td { padding: .35rem .25rem; border-top: 1px solid rgba(127, 127, 127, .15); vertical-align: middle; }
    .ledger-bank-latest td:nth-child(2) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ledger-num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
    .ledger-num.is-in { color: #1f8a4c; }
    .ledger-num.is-out { color: #c0392b; }
    .ledger-bank-account { grid-template-columns: minmax(0, 1.4fr) auto minmax(0, auto); }
    .ledger-bank-name span, .ledger-bank-name strong { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    @container (max-width: 560px) { .ledger-bank-account { grid-template-columns: minmax(0, 1fr); } .ledger-bank-balance { text-align: left; } .ledger-bank-status { justify-content: flex-start; } .ledger-bank-latest td:nth-child(4) { display: none; } }
    @media (max-width: 640px) { .ledger-bank-account { grid-template-columns: minmax(0, 1fr); } .ledger-bank-balance { text-align: left; } .ledger-bank-status { justify-content: flex-start; } .ledger-bank-latest td:nth-child(4) { display: none; } }
</style>
{% endif %}
