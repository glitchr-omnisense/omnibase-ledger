{# Base\Ledger\Admin\Widget\BankWidgetType: the bank accounts, their balance in the books and at
   the bank and what waits to be reconciled, then the latest lines; who manages the books connects
   a bank or imports a statement from here. omnibase/admin's dashboard card. #}
{% if allowed %}
<section class="dash-card ledger-bank">
    <header class="dash-card-head">
        <div class="dash-card-titles">
            <h2 class="dash-card-title">{{ widget.label|trans({}, 'admin') }}</h2>
            <span class="dash-card-sub">{{ 'dashboard.accounts_count'|trans({count: accounts|length}, 'ledger') }}</span>
        </div>
    </header>
    <div class="dash-card-panel">
    {# Who manages the books can connect a bank or import a statement, before the first account as after it. #}
    {% set actions %}
        {% if can_manage %}
        <div class="ledger-bank-actions">
            {% for name, label in gateways %}
                <a class="dash-row-action{{ accounts is not empty ? ' is-quiet' }}" href="{{ path('ledger_admin_bank_connect', {gateway: name, book: book.id, _token: csrf_token('ledger_bank_connect')}) }}"><i class="fa-solid fa-building-columns"></i> {{ 'dashboard.bank.connect'|trans({gateway: label}, 'ledger') }}</a>
            {% endfor %}
            {% if files %}
                <a class="dash-row-action is-quiet" href="{{ path('ledger_admin_bank_connect', {gateway: 'files', book: book.id}) }}"><i class="fa-solid fa-file-arrow-up"></i> {{ 'bank.upload'|trans({}, 'ledger') }}</a>
            {% endif %}
            {% if gateways is empty and not files %}<span class="ld-muted">{{ 'dashboard.bank.no_gateway'|trans({}, 'ledger') }}</span>{% endif %}
        </div>
        {% endif %}
    {% endset %}
    {% if accounts is empty %}
        <p class="dash-empty">{{ 'dashboard.no_account'|trans({}, 'ledger') }}</p>
        {{ actions }}
    {% else %}
    <ul class="dash-rows ledger-bank-accounts">
        {% for row in accounts %}
        {% set account = row.account %}
        <li class="ledger-bank-account">
            <div class="dash-row">
                <i class="fa-solid fa-building-columns dash-row-icon" aria-hidden="true"></i>
                <span class="dash-row-label">{{ account.name }}<small>{{ account.iban|ledger_iban }}{% if account.lastSyncedAt %} · {{ 'dashboard.bank.synced'|trans({date: account.lastSyncedAt|date('d/m H:i')}, 'ledger') }}{% endif %}</small></span>
                <span class="dash-row-value">{{ row.balance|ledger_money(account.currency) }}{% if row.bankBalance is not null %}<small class="ledger-bank-at" title="{{ row.bankBalanceAt ? row.bankBalanceAt|date('d/m/Y H:i') }}">{{ 'dashboard.bank.at_bank'|trans({amount: row.bankBalance|ledger_money(account.currency)}, 'ledger') }}</small>{% endif %}</span>
                <span class="ledger-bank-status">
                    {% if row.needsRenewal %}
                        <a class="ledger-pill is-alert" href="{{ path('ledger_admin_bank_renew', {connection: row.connection.id, _token: csrf_token('ledger_bank_renew_' ~ row.connection.id)}) }}">{{ 'dashboard.bank.renew'|trans({}, 'ledger') }}</a>
                    {% elseif row.connection.consentStatus.value == 'active' %}
                        <span class="ledger-pill is-ok">{{ 'dashboard.bank.connected'|trans({}, 'ledger') }}</span>
                    {% elseif row.connection.gateway == 'files' %}
                        <a class="ledger-pill" href="{{ path('ledger_admin_bank_upload', {bankAccount: account.id}) }}">{{ 'dashboard.bank.statements'|trans({}, 'ledger') }}</a>
                    {% endif %}
                    <a class="ledger-pill{{ row.pending > 0 ? ' is-waiting' }}" href="{{ path('ledger_admin_reconcile', {bankAccount: account.id}) }}">{{ 'dashboard.bank.to_reconcile'|trans({count: row.pending}, 'ledger') }}</a>
                </span>
            </div>
        </li>
        {% endfor %}
    </ul>
    {% if latest is not empty %}
    <h3 class="ledger-bank-subtitle">{{ 'dashboard.bank.latest'|trans({}, 'ledger') }}</h3>
    <table class="ledger-bank-latest">
        {% for line in latest %}
        <tr>
            <td class="ledger-muted">{{ line.bookedOn|date('d/m') }}</td>
            <td><span class="ledger-label">{{ line.label }}</span>{% if line.counterpartyName %}<span class="ledger-muted"> · {{ line.counterpartyName }}</span>{% endif %}</td>
            <td class="ledger-num {{ line.amount > 0 ? 'is-in' : 'is-out' }}">{{ line.amount > 0 ? '+' }}{{ line.amount|ledger_money(line.currency) }}</td>
            <td><span class="ledger-pill is-{{ line.status.value }}">{{ ('status.' ~ line.status.value)|trans({}, 'ledger') }}</span></td>
        </tr>
        {% endfor %}
    </table>
    {% endif %}
    {% if can_manage %}<div class="ledger-bank-more">{{ actions }}</div>{% endif %}
    {% endif %}
    </div>
</section>
<style>
    .ledger-bank .dash-row { grid-template-columns: auto minmax(0, 1fr) auto; }
    .ledger-bank .dash-row-label small, .ledger-bank-at { display: block; font-weight: 400; color: var(--admin-muted); font-size: .76rem; }
    .ledger-bank .dash-row-value { font-size: 1rem; }
    .ledger-bank-status { grid-column: 2 / -1; display: flex; flex-wrap: wrap; gap: .35rem; }
    .ledger-bank-actions { display: flex; flex-wrap: wrap; gap: .5rem; align-items: center; }
    .ledger-bank-actions .dash-row-action.is-quiet { background: var(--admin-tint-strong); color: var(--admin-text); }
    .ledger-bank-more { margin-top: .9rem; }
    .ledger-bank-subtitle { margin: 1rem 0 .4rem; font-size: .9rem; font-weight: 700; color: var(--admin-text); }
    .ledger-muted { font-size: .8rem; color: var(--admin-muted); }
    .ledger-pill { display: inline-block; padding: .12rem .55rem; border-radius: 999px; font-size: .74rem; background: var(--admin-tint-strong); color: var(--admin-text); text-decoration: none; white-space: nowrap; }
    .ledger-pill.is-ok, .ledger-pill.is-reconciled { background: color-mix(in srgb, var(--admin-success) 15%, transparent); color: var(--admin-text); }
    .ledger-pill.is-alert, .ledger-pill.is-unmatched { background: color-mix(in srgb, var(--admin-danger) 15%, transparent); color: var(--admin-danger); }
    .ledger-pill.is-waiting, .ledger-pill.is-suggested { background: color-mix(in srgb, var(--admin-warning) 18%, transparent); color: var(--admin-text); }
    .ledger-bank-latest { width: 100%; border-collapse: separate; border-spacing: 0 .2rem; font-size: .84rem; table-layout: fixed; }
    .ledger-bank-latest td { padding: .45rem .4rem; vertical-align: middle; }
    .ledger-bank-latest tr:nth-child(odd) td { background: var(--admin-tint); }
    .ledger-bank-latest td:first-child { width: 3rem; border-radius: 10px 0 0 10px; padding-left: .7rem; }
    .ledger-bank-latest td:last-child { border-radius: 0 10px 10px 0; padding-right: .7rem; }
    .ledger-bank-latest td:nth-child(3) { width: 7.5rem; } .ledger-bank-latest td:nth-child(4) { width: 6.5rem; }
    .ledger-bank-latest td:nth-child(2) { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .ledger-num { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; font-weight: 600; }
    .ledger-num.is-in { color: var(--admin-success); }
    @container (max-width: 560px) { .ledger-bank-latest td:nth-child(4) { display: none; } }
</style>
{% endif %}
