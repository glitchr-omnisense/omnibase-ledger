{# Base\Ledger\Admin\Widget\BooksWidgetType: each book's fiscal year to date as rows - income,
   expenses, result, what is owed and what is to pay, cash - each opening its report, and the
   book's statements a click away. omnibase/admin's dashboard card. #}
{% if books is not empty %}
<div class="ledger-books-stack">
{% for row in books %}
{% set book = row.book %}
{% set period = {book: book.id, from: row.from|date('Y-m-d'), to: row.to|date('Y-m-d')} %}
<section class="dash-card ledger-books">
    <header class="dash-card-head">
        <div class="dash-card-titles">
            <h2 class="dash-card-title">{{ widget.label|trans({}, 'admin') }}{% if books|length > 1 %} · {{ book.name }}{% endif %}</h2>
            <span class="dash-card-sub">{{ 'dashboard.books.year'|trans({year: row.year, date: row.to|date('d/m/Y')}, 'ledger') }}</span>
        </div>
        <span class="dash-card-actions">
            <a class="dash-card-action" href="{{ path('ledger_admin_income_statement', period) }}" title="{{ 'report.income_statement'|trans({}, 'ledger') }}"><i class="fa-solid fa-chart-line"></i></a>
            <a class="dash-card-action" href="{{ path('ledger_admin_balance_sheet', {book: book.id, at: row.to|date('Y-m-d')}) }}" title="{{ 'report.balance_sheet'|trans({}, 'ledger') }}"><i class="fa-solid fa-building-columns"></i></a>
            <a class="dash-card-action" href="{{ path('ledger_admin_trial_balance', period) }}" title="{{ 'report.trial_balance'|trans({}, 'ledger') }}"><i class="fa-solid fa-scale-balanced"></i></a>
        </span>
    </header>
    <div class="dash-card-panel">
        <ul class="dash-rows ledger-books-rows">
            <li><a class="dash-row" href="{{ path('ledger_admin_income_statement', period) }}"><span class="dash-row-label">{{ 'dashboard.books.income'|trans({}, 'ledger') }}</span><i class="fa-solid fa-chart-line dash-row-icon" aria-hidden="true"></i><span class="dash-row-value">{{ row.income|ledger_money(book.currency) }}</span></a></li>
            <li><a class="dash-row" href="{{ path('ledger_admin_income_statement', period) }}"><span class="dash-row-label">{{ 'dashboard.books.expenses'|trans({}, 'ledger') }}</span><i class="fa-solid fa-chart-line dash-row-icon" aria-hidden="true"></i><span class="dash-row-value">{{ row.expenses|ledger_money(book.currency) }}</span></a></li>
            <li><a class="dash-row" href="{{ path('ledger_admin_income_statement', period) }}"><span class="dash-row-label">{{ 'dashboard.books.result'|trans({}, 'ledger') }}</span><i class="fa-solid fa-chart-line dash-row-icon" aria-hidden="true"></i><span class="dash-row-value {{ row.result >= 0 ? 'is-good' : 'is-bad' }}">{{ row.result|ledger_money(book.currency) }}</span></a></li>
            <li><a class="dash-row" href="{{ path('ledger_admin_open_items', {book: book.id, account: '411'}) }}"><span class="dash-row-label">{{ 'dashboard.books.receivables'|trans({}, 'ledger') }}</span><i class="fa-solid fa-list-check dash-row-icon" aria-hidden="true"></i><span class="dash-row-value">{{ row.receivables|ledger_money(book.currency) }}</span></a></li>
            <li><a class="dash-row" href="{{ path('ledger_admin_open_items', {book: book.id, account: '401'}) }}"><span class="dash-row-label">{{ 'dashboard.books.payables'|trans({}, 'ledger') }}</span><i class="fa-solid fa-list-check dash-row-icon" aria-hidden="true"></i><span class="dash-row-value">{{ row.payables|ledger_money(book.currency) }}</span></a></li>
            <li><a class="dash-row" href="{{ path('ledger_admin_general_ledger', {book: book.id, account: '512', year: row.yearEnd}) }}"><span class="dash-row-label">{{ 'dashboard.books.cash'|trans({}, 'ledger') }}</span><i class="fa-solid fa-chart-line dash-row-icon" aria-hidden="true"></i><span class="dash-row-value">{{ row.cash|ledger_money(book.currency) }}</span></a></li>
        </ul>
    </div>
</section>
{% endfor %}
</div>
<style>
    .ledger-books-stack { display: flex; flex-direction: column; gap: 1.25rem; flex: 1 1 auto; min-width: 0; }
    .ledger-books-rows .dash-row { grid-template-columns: minmax(0, 1fr) auto minmax(6.5rem, auto); }
    .ledger-books-rows .dash-row-value.is-good { color: var(--admin-success); }
    .ledger-books-rows .dash-row-value.is-bad { color: var(--admin-danger); }
</style>
{% endif %}
